          {
            "id": 135,
            "name": "Script",
            "kind": "Script",
            "pos": [
              0,
              0,
              0
            ],
            "rot": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ],
            "source": "-- Disco Floor: every tile (and the light) changes colour to the beat.\nlocal floor = script.Parent\n\nwhile true do\n    for _, tile in ipairs(floor:GetChildren()) do\n        if tile:IsA(\"BasePart\") then\n            tile.Color = Color3.fromHSV(math.random(), 0.9, 1)\n        end\n    end\n    floor.PartyLight.Color = Color3.fromHSV(math.random(), 0.8, 1)\n    wait(0.4)\nend\n",
            "enabled": true
          }
        ]
