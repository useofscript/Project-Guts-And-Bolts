          {
            "id": 449,
            "name": "RideTimer",
            "kind": "Script",
            "pos": [
              0,
              0,
              0
            ],
            "rot": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ],
            "source": "-- Times your ride from the top to the splash.\nlocal startLine = script.Parent:FindFirstChild(\"StartLine\")\nlocal finishLine = script.Parent:FindFirstChild(\"FinishLine\")\nlocal started = nil\n\nstartLine.Touched:Connect(function(hit)\n    if not hit.Parent:FindFirstChild(\"Humanoid\") then return end\n    if started and time() - started < 3 then return end\n    started = time()\n    Gui.Message(\"WHEEEE!\", 2)\nend)\n\nfinishLine.Touched:Connect(function(hit)\n    if not started or not hit.Parent:FindFirstChild(\"Humanoid\") then return end\n    local ride = time() - started\n    started = nil\n    Gui.Label(\"RideTime\", nil)\n    Gui.Message(\"SPLASH! Your ride took \" .. string.format(\"%.1f\", ride) .. \" seconds.\", 5)\n    Sounds.Play(\"win\")\nend)\n\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    if started then Gui.Label(\"RideTime\", \"Ride: \" .. string.format(\"%.1f\", time() - started) .. \"s\") end\nend)\n",
            "enabled": true
          }
        ]
      },
