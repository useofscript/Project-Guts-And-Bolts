        "castShadow": true,
        "children": [
          {
            "id": 114,
            "name": "Script",
            "kind": "Script",
            "pos": [
              0,
              0,
              0
            ],
            "rot": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ],
            "source": "-- Moving Platform: slides back and forth. Stand on it to ride along!\nlocal part = script.Parent\nlocal start = part.Position\nlocal distance = 8     -- how far it travels\nlocal speed = 0.4      -- how fast\n\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    local offset = math.sin(time() * speed * math.pi) * distance / 2\n    part.Position = start + Vector3.new(offset, 0, 0)\nend)\n",
            "enabled": true
          }
        ]
      },
      {
        "id": 117,
        "name": "FadingPlatform1",
        "kind": "Part",
        "pos": [
          0,
          3.5,
          -31
        ],
        "rot": [
          0,
          0,
          0
        ],
        "size": [
          3.5,
          0.6,
          3.5
        ],
        "shape": "Cube",
        "color": [
          0.3,
          0.75,
          0.95
        ],
        "material": "Plastic",
        "anchored": true,
        "canCollide": true,
        "transparency": 0.0,
        "castShadow": true,
        "children": [
          {
            "id": 116,
            "name": "Script",
            "kind": "Script",
            "pos": [
              0,
              0,
              0
            ],
            "rot": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ],
            "source": "-- Disappearing Platform: fades away when stepped on, then comes back.\nlocal part = script.Parent\nlocal busy = false   -- a \"debounce\" so it only runs once at a time\n\npart.Touched:Connect(function(hit)\n    if busy or not hit.Parent:FindFirstChild(\"Humanoid\") then return end\n    busy = true\n\n    for i = 1, 10 do\n        part.Transparency = i / 10\n        wait(0.08)\n    end\n    part.CanCollide = false   -- now you fall through!\n\n    wait(3)\n    part.CanCollide = true\n    part.Transparency = 0\n    busy = false\nend)\n",
            "enabled": true
          }
        ]
      },
