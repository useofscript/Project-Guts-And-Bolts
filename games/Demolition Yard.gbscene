      {
        "id": 128,
        "name": "ExplodingBarrel",
        "kind": "Part",
        "pos": [
          -4,
          0.75,
          -4
        ],
        "rot": [
          0,
          0,
          0
        ],
        "size": [
          1,
          1.5,
          1
        ],
        "shape": "Cylinder",
        "color": [
          0.8,
          0.12,
          0.08
        ],
        "material": "Metal",
        "anchored": false,
        "canCollide": true,
        "transparency": 0.0,
        "castShadow": true,
        "children": [
          {
            "id": 127,
            "name": "Script",
            "kind": "Script",
            "pos": [
              0,
              0,
              0
            ],
            "rot": [
              0,
              0,
              0
            ],
            "size": [
              1,
              1,
              1
            ],
            "source": "-- Exploding Barrel: click it, or knock it over, and BOOM.\nlocal barrel = script.Parent\nlocal done = false\n\nlocal function boom()\n    if done then return end\n    done = true\n    Explode(barrel.Position, 10, 1.5)\n    barrel:Destroy()\nend\n\nbarrel.Clicked:Connect(boom)\nbarrel.Touched:Connect(function(hit)\n    -- Blow up if something slams into it fast.\n    if hit.AssemblyLinearVelocity.Magnitude > 12 then boom() end\nend)\n",
            "enabled": true
          }
        ]
      },
