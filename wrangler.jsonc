// Cloudflare settings for the Guts&Bolts website.
//   - website/ is served as it is (the pages, pictures and the web app).
//   - worker/index.js answers /api: it passes the web app's requests on to the
//     Guts&Bolts server at GB_SERVER (change it here or in the dashboard).
{
  "name": "project-guts-and-bolts",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "GB_SERVER": "rails-volley.tun.ply.gg:61229"
  }
}
